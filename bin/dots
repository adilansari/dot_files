#!/usr/bin/env bash
set -euo pipefail

self=${BASH_SOURCE[0]}
if [[ -L $self ]]; then
  self=$(readlink "$self")
fi
DOT=$(cd "$(dirname "$self")/.." && pwd)

state=${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/profile
OVERLAY_DIR=
if [[ -f $state ]]; then
  # shellcheck source=/dev/null
  source "$state"
fi

repos=("$DOT")
if [[ -n $OVERLAY_DIR && -d $OVERLAY_DIR/.git ]]; then
  repos+=("$OVERLAY_DIR")
fi

cmd=${1:-}
if [[ $# -gt 0 ]]; then
  shift
fi

case $cmd in
  status)
    for r in "${repos[@]}"; do
      echo "== $r"
      git -C "$r" status -sb
    done
    if [[ -n $OVERLAY_DIR && -d $OVERLAY_DIR && ! -d $OVERLAY_DIR/.git ]]; then
      echo "== $OVERLAY_DIR"
      echo "plain folder, not a git repo: no history and no backup"
    fi
    ;;
  sync)
    for r in "${repos[@]}"; do
      git -C "$r" pull --ff-only
    done
    "$DOT/install.sh" "$@"
    ;;
  doctor)
    "$DOT/install.sh" --check
    ;;
  *)
    echo "usage: dots status|sync|doctor" >&2
    exit 2
    ;;
esac
